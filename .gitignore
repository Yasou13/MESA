# ==============================================================================
# MESA Memory Layer - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
env/
venv/
build/
dist/
*.egg-info/
*.egg
*.whl
pip-wheel-metadata/
.coverage
.coverage.*
coverage.xml
htmlcov/
bench_results.json
.benchmarks/
.tox/
.nox/
node_modules/
packages/mesa-memory/src/mesa_runtime/static/dashboard/
packages/mesa-benchmark/src/mesa_benchmark/dashboard/static/
test-results/
playwright-report/
*.tsbuildinfo
apps/benchmark-dashboard/vite.config.js
apps/benchmark-dashboard/vite.config.d.ts

# ------------------------------------------------------------------------------
# 2. MESA Databases & Vector Storage (Zero Trust / Critical)
#    Strictly ignore all clinical data, embeddings, and raw transaction logs.
# ------------------------------------------------------------------------------
# Relational & Graph DBs
*.db
*.sqlite3

# RocksDB
*.rocksdb
rocksdict_archive/

# Vector Storage (LanceDB)
*.lance
vector_index.lance

# RBAC Policy DB (auto-generated, not source-controlled)

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets
#    Never commit API keys (OpenAI, Anthropic, Groq) or local config overrides.
# ------------------------------------------------------------------------------
.env
.env.local
.env.test
.env.*
!.env.example

# ------------------------------------------------------------------------------
# 4. Model Caches & Large Binaries
#    REBEL / HuggingFace transformer weights should never enter the repo.
# ------------------------------------------------------------------------------
models/
huggingface_cache/
*.bin
*.pt
*.onnx
*.safetensors
.cache/

# ------------------------------------------------------------------------------
# 5. OS & IDE Configuration
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 6. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
tmp/
temp/
scratch/
scratch*.py
test_minimal*.py
storage_bench_tmp/
eval_results.json
sweep_results.json
*.jsonl

# ------------------------------------------------------------------------------
# 7. Jupyter Notebook Checkpoints
# ------------------------------------------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 8. Agent / Tooling Metadata
# ------------------------------------------------------------------------------
.gemini/
.audit/
.agents/
.codex/

# ------------------------------------------------------------------------------
# 9. Local Data
#    Runtime and ad-hoc datasets remain local.
# ------------------------------------------------------------------------------
data/

# Test storage directories (dynamically created by conftest.py)
.test_storage_tmp/
*.sqlite

# ------------------------------------------------------------------------------
# 10. Ephemeral Benchmark & Evaluation Artifacts
#     Generated by mesa_evals, pytest-benchmark, and load-test scripts.
#     Never commit these — they are machine-specific and non-reproducible.
# ------------------------------------------------------------------------------
bench_*.sqlite
bench_*.db
legal_golden.json
soak_test_*.jsonl
temp_*.py
temp_*.md

# Test Databases
test_db/
test_db_*/
*.db
*.lance/
.kuzu/
.ci_storage_test/
test_db
test_db_2
test_db_3
test_kuzu_db
# Repository-local runtime data is legacy-only; XDG directories are canonical.
/storage/
/results/
/mesa-benchmark/
packages/mesa-benchmark/results/

# Ephemeral benchmark execution artifacts
*.bak
mutants/
report_*.md
reproducibility_report.json
state.json
colab_sonuc.md
_temp_config.yaml
beam_eval_report.json
rewrite_harness.py
test_node.py
test_qdrant/
# External/generated payloads are reproduced by `mesa-benchmark dataset-sync`.
packages/mesa-benchmark/datasets/external/beam/v2/dataset.json
packages/mesa-benchmark/datasets/external/locomo/dataset.json
packages/mesa-benchmark/datasets/external/longmemeval/dataset.json
packages/mesa-benchmark/datasets/external/memoryagentbench/dataset.json
packages/mesa-benchmark/datasets/external/memoryagentbench/recsys.json
packages/mesa-benchmark/datasets/generated/beam/scale/*.json
packages/mesa-benchmark/datasets/generated/beam/ablations/*.json
packages/mesa-benchmark/datasets/external_raw/

.gemini_diff.txt
mcp_test1.md
mesa_control_panel.md
