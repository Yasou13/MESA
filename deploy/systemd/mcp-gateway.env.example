# Install as /etc/mesa/mcp-gateway.env with mode 0600. Do not commit real values.
MESA_BASE_URL=http://127.0.0.1:8000
MESA_GATEWAY_CONTROL_DB=/var/lib/mesa/data/mesa.db
MESA_API_KEY=replace-with-mesa-api-key
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MESA_GATEWAY_ENCRYPTION_KEY=replace-with-fernet-key
