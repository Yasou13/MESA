# This is a standalone runtime template. Compose supplies role, storage and
# model/provider flags itself; pass MESA_API_KEY and MESA_PRINCIPAL_ID via a
# secret manager or exported environment variables instead of committing `.env`.
# Copy explicitly and load only via MESA_DOTENV_PATH when policy permits.
MESA_RUNTIME_PROFILE=combined
MESA_STORAGE_ROOT=/var/lib/mesa/data
MESA_LOAD_DOTENV=false
MESA_MODEL_ENABLED=false
# Each defaults to MESA_MODEL_ENABLED when unset.
# MESA_EMBEDDING_ENABLED=false
# MESA_EXTRACTION_ENABLED=false
# Graph is independent of model flags; false never opens Kùzu.
MESA_GRAPH_ENABLED=true
MESA_EXTERNAL_PROVIDER_ENABLED=false
MESA_V4_REBUILD_ENABLED=false
MESA_V4_GRAPH_TIMEOUT_SECONDS=15.0
MESA_EMBEDDING_VERSION=v1
MESA_EMBEDDING_MODEL=local:magibu/embeddingmagibu-200m
# Detected once at startup when embedding is enabled; otherwise defaults to 768.
# MESA_EMBEDDING_DIMENSION=768
MESA_EMBEDDING_NORMALIZED=true
MESA_LLM_MODEL=ollama:qwen3:8b
# MESA_LLM_API_KEY=replace-with-secret-manager-reference
MESA_EXTRACTION_THINKING=false

# External embedding profile example (OpenAI-compatible text-embedding-3-small)
# MESA_EXTERNAL_PROVIDER_ENABLED=true
# MESA_EMBEDDING_MODEL=openai_compatible:text-embedding-3-small
# MESA_EMBEDDING_DIMENSION=1536

# NVIDIA Nemotron-3 asymmetric embedding profile
# MESA_EXTERNAL_PROVIDER_ENABLED=true
# MESA_EMBEDDING_MODEL=openai_compatible:nvidia/nemotron-3-embed-1b
# MESA_EMBEDDING_DIMENSION=2048
# MESA_EMBEDDING_VERSION=nemotron-qpass-v1
# MESA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
# MESA_EMBEDDING_API_KEY=replace-with-secret-manager-reference
# Validation Policy:
# 0 = Deterministic validation only (zero validation LLMs required)
# 1 = Single LLM validator (requires validator A)
# 2 = Dual LLM consensus (requires distinct validators A and B)
# If omitted: defaults to 0; mode 1 or 2 must be set explicitly.
# MESA_TIER3_MODE=2
# MESA_TIER3_LLM_PROVIDER_A=openai_compatible
# MESA_TIER3_LLM_MODEL_A=gpt-4o-mini
# MESA_TIER3_LLM_PROVIDER_B=ollama
# MESA_TIER3_LLM_MODEL_B=llama3.2:3b
# MESA_OLLAMA_URL=http://localhost:11434
# MESA_OLLAMA_TIMEOUT_SECONDS=300.0
# MESA_OLLAMA_NUM_CTX=8192
MESA_API_KEY=replace-with-secret-manager-reference
MESA_PRINCIPAL_ID=replace-with-server-side-principal
MESA_PRINCIPAL_TYPE=SERVICE
MESA_PRINCIPAL_STATUS=active
MESA_PORT=8000

# V4 uses one combined storage owner. Catalog memberships and agent/dataset
# grants are provisioned with `mesa-v4-admin`; they are not inferred from
# request fields or automatically granted from these environment variables.
# MESA_RUNTIME_PROFILE=combined
# MESA_MODEL_ENABLED=true
# MESA_EXTERNAL_PROVIDER_ENABLED=true
# MESA_TENANT_ID=tenant-a
# MESA_WORKSPACE_ID=workspace-a
# MESA_DATASET_IDS=dataset-a
# MESA_AGENT_ID=agent-a

# Sample limits below intentionally tighten the code defaults (50000 / 2 GiB).
# Per-tenant bounds must not exceed these sample global bounds.
# Queue admission remains bounded. Override only through reviewed deployment config.
MESA_QUEUE_MAX_PENDING_RECORDS=10000
MESA_QUEUE_MAX_PENDING_BYTES=536870912
MESA_QUEUE_MAX_PENDING_RECORDS_PER_TENANT=10000
MESA_QUEUE_MAX_PENDING_BYTES_PER_TENANT=536870912
MESA_QUEUE_MAX_IN_FLIGHT_RECORDS=32

# Local MESA MCP client (stdio).  Keep MESA_API_KEY out of this template.
# MESA_BASE_URL=http://localhost:8000
# MESA_NAMESPACE=local
# MESA_PROJECT_ID=mesa
# MESA_ACTOR_ID=antigravity-agent
# MESA_WORKSPACE_ROOT=/absolute/path/to/MESA
# MESA_SEARCH_DEFAULT_LIMIT=8
# MESA_SEARCH_MAX_LIMIT=20
# MESA_CONTEXT_DEFAULT_TOKEN_BUDGET=2500
# MESA_CONTEXT_MAX_TOKEN_BUDGET=8000
